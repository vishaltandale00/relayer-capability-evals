{
  "name": "relayer-capability-evals",
  "version": "0.1.0",
  "description": "Standalone project capability evaluation catalog for Relayer GraphComplete.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/capability-evals"
  ],
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "setup": "node scripts/link-runner-sdk.mjs",
    "build": "npm run build -w @relayer/capability-evals",
    "check": "npm run check -w @relayer/capability-evals && npm test -w @relayer/capability-evals",
    "test": "npm test -w @relayer/capability-evals",
    "eval:admit:node-redis": "node scripts/verify-node-redis-case-admission.mjs",
    "eval:admit:jupyterlab-execution-bundles": "node scripts/verify-jupyterlab-execution-bundles-admission.mjs",
    "eval:admit:emergency-evacuation": "node scripts/verify-emergency-evacuation-admission.mjs",
    "eval:admit:httpcore": "node scripts/run-httpcore-admission.mjs",
    "eval:admit:excalidraw-scene-history": "node scripts/verify-excalidraw-scene-history-admission.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^43.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9"
  }
}
