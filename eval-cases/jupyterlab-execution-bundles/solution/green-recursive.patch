+import {
+  compareExecutionBundle,
+  executionBundleStatus,
+  exportExecutionBundle,
+  importExecutionBundle
+} from '../src';
+import { webcrypto } from 'node:crypto';
+
+Object.defineProperty(globalThis, 'crypto', { configurable: true, value: webcrypto });
+
+describe('execution bundles', () => {
+  it('round trips immutable evidence and compares a rerun', async () => {
+    const files = [{ path: 'input.csv', bytes: new TextEncoder().encode('x\n1\n') }];
+    const executions = [
+      { cellId: 'a', source: '1 + 1', executionCount: 1, state: 'completed' as const, outputs: [2] }
+    ];
+    const bundle = await exportExecutionBundle({ environment: { kernel: 'python3' }, executions, referencedFiles: files });
+    const result = await importExecutionBundle(JSON.stringify(bundle), files);
+    expect(result.status).toBe('verified');
+    expect(Object.isFrozen(result.bundle.executions[0].outputs)).toBe(true);
+    await expect(compareExecutionBundle(result.bundle, { environment: { kernel: 'python3' }, executions }, files)).resolves.toMatchObject({ status: 'rerun-match' });
+    const host = document.createElement('div');
+    const status = executionBundleStatus('verified', host);
+    expect(status).toMatchObject({ label: 'Verified', readOnly: true });
+    expect(status.node.outerHTML).toBe(
+      '<span data-tone="positive" aria-readonly="true">Verified</span>'
+    );
+    expect(host.contains(status.node)).toBe(true);
+    await expect(importExecutionBundle('null', files)).resolves.toMatchObject({
+      status: 'tampered'
+    });
+  });
+});
